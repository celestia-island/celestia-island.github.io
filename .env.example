# Copy this file to .env (gitignored) and adjust as needed.
#
# Extra footer content rendered below the copyright line — one line per entry.
# Two formats are accepted, injected into the page at container start
# (docker/entrypoint.sh):
#
#   1. A JSON array of raw-HTML strings (recommended; supports multi-line):
#      FOOTER_EXTRA=["<a href=\"...\">line one</a>", "<a href=\"...\">line two</a>"]
#   2. A single raw-HTML string:
#      FOOTER_EXTRA=<a href="...">single line</a>
#
# Keep the value on a single line; lines starting with "#" are comments.
#
# Chinese ICP filing line (beian) — our registered number; append more
# entries (e.g. 网安备案) later:
FOOTER_EXTRA=["<a href=\"https://beian.miit.gov.cn/\" target=\"_blank\" rel=\"noopener\">苏ICP备2025155733号-2</a>"]
